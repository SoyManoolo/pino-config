{
  "name": "pino-config",
  "version": "3.0.0",
  "description": "Custom Pino configuration for database logging.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoyManoolo/pino-config.git"
  },
  "bugs": {
    "url": "https://github.com/SoyManoolo/pino-config/issues"
  },
  "homepage": "https://github.com/SoyManoolo/pino-config#readme",
  "type": "commonjs",
  "main": "./dist/index.cjs.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs.js"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "format": "prettier --write README.md",
    "format:check": "prettier --check README.md",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.9.8",
    "typescript": "^5.0.0",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.0.0"
  }
}
